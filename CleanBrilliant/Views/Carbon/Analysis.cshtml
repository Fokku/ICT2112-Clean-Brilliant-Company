@{
    ViewData["Title"] = "Carbon Analysis";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Carbon Analysis</h2>
        <a href="/Carbon" class="text-decoration-none" style="font-size:.9rem;">← Back to Dashboard</a>
    </div>

    <div style="max-width:600px;margin:0 auto;">
        <!-- Shipping Recommendation -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Shipping Recommendation</h6>
                <form id="recommend-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="analysis-postal" class="form-label" style="font-size:.85rem;">Postal Code</label>
                            <input type="text" class="form-control" id="analysis-postal" placeholder="e.g. 123456" required>
                        </div>
                        <div class="col">
                            <label for="analysis-delivery" class="form-label" style="font-size:.85rem;">Delivery Speed</label>
                            <select class="form-select" id="analysis-delivery" required>
                                <option value="1">Priority (Fastest)</option>
                                <option value="2">Express (Fast)</option>
                                <option value="3" selected>Standard (Eco-Friendly)</option>
                            </select>
                        </div>
                        <div class="col">
                            <label for="analysis-country" class="form-label" style="font-size:.85rem;">Country</label>
                            <input type="text" class="form-control" id="analysis-country" value="SG">
                        </div>
                        <div class="col">
                            <label for="analysis-strategy" class="form-label" style="font-size:.85rem;">Mode</label>
                            <select class="form-select" id="analysis-strategy" required>
                                <option value="rules" selected>Current Rules</option>
                                <option value="duration">Route Duration</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Get Recommendation</button>
                        </div>
                    </div>
                </form>
                <div id="recommend-result" class="mt-3 p-2 border rounded bg-light" style="display:none;"></div>
            </div>
        </div>

        <!-- Shipping Carbon Estimate -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Shipping Carbon Estimate</h6>
                <form id="estimate-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="estimate-method" class="form-label" style="font-size:.85rem;">Shipping Method</label>
                            <select class="form-select" id="estimate-method">
                                <option value="truck">Truck</option>
                                <option value="air">Air</option>
                                <option value="ship">Ship</option>
                                <option value="rail">Rail</option>
                            </select>
                        </div>
                        <div class="col">
                            <label for="estimate-distance" class="form-label" style="font-size:.85rem;">Distance (km)</label>
                            <input type="number" class="form-control" id="estimate-distance" step="0.1" min="0" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Estimate</button>
                        </div>
                    </div>
                </form>
                <div id="estimate-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <!-- Carbon Level Analysis -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Carbon Level Analysis</h6>
                <form id="analyze-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="analyze-carbon" class="form-label" style="font-size:.85rem;">Total Carbon (tonnes)</label>
                            <input type="number" class="form-control" id="analyze-carbon" step="0.1" min="0" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Analyze</button>
                        </div>
                    </div>
                </form>
                <div id="analyze-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initAnalysis(); });</script>
}
