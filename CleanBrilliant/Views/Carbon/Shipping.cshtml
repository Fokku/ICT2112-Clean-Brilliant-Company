@{
    ViewData["Title"] = "Shipping Carbon Lookup";
}

<div class="container py-4" id="shipping-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Shipping Carbon Lookup</h2>
        <a href="/Carbon" class="text-decoration-none" style="font-size:.9rem;">← Back to Dashboard</a>
    </div>

    <div style="max-width:600px;margin:0 auto;">
        <!-- Customer Order Lookup -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Customer Distance Carbon</h6>
                <form id="order-lookup-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="ship-order-id" class="form-label" style="font-size:.85rem;">Order ID</label>
                            <input type="text" class="form-control" id="ship-order-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Lookup</button>
                        </div>
                    </div>
                </form>
                <div id="order-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <!-- Supplier Restock Lookup -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Supplier Distance Carbon</h6>
                <form id="restock-lookup-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="ship-restock-id" class="form-label" style="font-size:.85rem;">Restock ID</label>
                            <input type="text" class="form-control" id="ship-restock-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Lookup</button>
                        </div>
                    </div>
                </form>
                <div id="restock-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Customer Order Total Carbon Summary</h6>
                <form id="order-summary-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="summary-order-id" class="form-label" style="font-size:.85rem;">Order ID</label>
                            <input type="text" class="form-control" id="summary-order-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Lookup</button>
                        </div>
                    </div>
                </form>
                <div id="order-summary-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Supplier Restock Total Carbon Summary</h6>
                <form id="restock-summary-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="summary-restock-id" class="form-label" style="font-size:.85rem;">Restock ID</label>
                            <input type="text" class="form-control" id="summary-restock-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Lookup</button>
                        </div>
                    </div>
                </form>
                <div id="restock-summary-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-uppercase text-muted fw-semibold mb-0" style="font-size:.82rem;letter-spacing:.5px;">Total Carbon Logs</h6>
                    <a href="#" id="toggle-logs" class="text-decoration-none" style="font-size:.9rem;">View Carbon Calculation Logs</a>
                </div>
                <div id="carbon-logs" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script src="~/js/shipping-logs.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initShipping(); });</script>
}
