@{
    ViewData["Title"] = "Route Calculation";
}

<div class="container py-4" id="hub-lookup-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Route Calculation</h2>
        <a href="/Carbon" class="text-decoration-none" style="font-size:.9rem;">← Back to Dashboard</a>
    </div>

    <div style="max-width:700px;margin:0 auto;">
        <div class="card">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Customer To Hub Route</h6>
                <form id="hub-lookup-form">
                    <div class="mb-3">
                        <label for="customer-postal-code" class="form-label" style="font-size:.85rem;">Customer Postal Code</label>
                        <input type="text" class="form-control" id="customer-postal-code" required>
                    </div>
                    <div class="mb-3">
                        <label for="hub-select" class="form-label" style="font-size:.85rem;">Current Hub</label>
                        <select class="form-select" id="hub-select" required>
                            <option value="">Loading hubs...</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Calculate Distance</button>
                </form>
                <div id="hub-lookup-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initHubLookup(); });</script>
}
