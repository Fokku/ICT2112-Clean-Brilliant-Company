@{
    ViewData["Title"] = "Route Calculation";
}

<div class="container py-4" id="hub-lookup-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Route Calculation</h2>
        <a href="/Carbon" class="text-decoration-none" style="font-size:.9rem;">← Back to Dashboard</a>
    </div>

    <div style="max-width:900px;margin:0 auto;">
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Inbound Route Test</h6>
                        <form id="inbound-route-form">
                            <div class="mb-3">
                                <label for="inbound-warehouse-select" class="form-label" style="font-size:.85rem;">Warehouse</label>
                                <select class="form-select" id="inbound-warehouse-select" required>
                                    <option value="">Loading warehouses...</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-outline-primary">Test Inbound Route</button>
                        </form>
                        <div id="inbound-route-result" class="mt-3" style="display:none;"></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Outbound Route Chain</h6>
                        <form id="hub-lookup-form">
                            <div class="mb-3">
                                <label for="warehouse-select" class="form-label" style="font-size:.85rem;">Origin Warehouse</label>
                                <select class="form-select" id="warehouse-select" required>
                                    <option value="">Loading warehouses...</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="country-code" class="form-label" style="font-size:.85rem;">Customer Country</label>
                                <select class="form-select" id="country-code" required>
                                    <option value="SG">Singapore</option>
                                    <option value="MY">Malaysia</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="transport-method" class="form-label" style="font-size:.85rem;">Cross-Border Transport</label>
                                <select class="form-select" id="transport-method" required>
                                    <option value="truck">Truck</option>
                                    <option value="ship">Ship</option>
                                    <option value="air">Air</option>
                                    <option value="rail">Train</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="customer-postal-code" class="form-label" style="font-size:.85rem;">Customer Postal Code / Location</label>
                                <input type="text" class="form-control" id="customer-postal-code" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Test Outbound Route</button>
                        </form>
                        <div id="hub-lookup-result" class="mt-3" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initHubLookup(); });</script>
}
