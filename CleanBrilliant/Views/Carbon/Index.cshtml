@{
    ViewData["Title"] = "Carbon Dashboard";
}

<div class="container py-4">
    <h2 class="mb-1">Carbon Footprint Dashboard</h2>
    <p class="text-muted mb-4">Overview of your organisation's carbon emissions</p>

    <div class="row g-3">
        <!-- Employees Card -->
        <div class="col-md-6">
            <a href="/Carbon/Employees" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Employees</span>
                            <span class="badge text-bg-primary"><span id="employee-count">—</span> <span id="employee-label">employees</span></span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Manage staff commute carbon tracking</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">View details →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Buildings Card -->
        <div class="col-md-6">
            <a href="/Carbon/Buildings" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Buildings</span>
                            <span class="badge text-bg-success"><span id="building-count">—</span> <span id="building-label">facilities</span></span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Track facility energy and gas emissions</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">View details →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Shipping Carbon Card -->
        <div class="col-md-6">
            <a href="/Carbon/Shipping" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Shipping Carbon</span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Look up carbon emissions for customer orders and supplier restocks</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">Look up →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Analysis Card -->
        <div class="col-md-6">
            <a href="/Carbon/Analysis" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Analysis</span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Get shipping recommendations and carbon level analysis</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">Analyze →</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initDashboard(); });</script>
}
