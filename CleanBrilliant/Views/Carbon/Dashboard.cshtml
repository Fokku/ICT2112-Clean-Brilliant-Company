@{
    ViewData["Title"] = "Carbon Dashboard";
}

<div class="container py-4">
    <h2 class="mb-1">Carbon Dashboard</h2>
    <p class="text-muted mb-4">Advanced carbon analysis and customization tools</p>

    <div class="row g-3">
        <!-- Custom Dashboard Card -->
        <div class="col-md-6">
            <a href="/Dashboard" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Custom Dashboard</span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Customize widgets and coefficient settings in your dashboard workspace</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">Open dashboard →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Toxic Product Analyzer Card -->
        <div class="col-md-6">
            <a href="/ToxicAnalyzer" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Toxic Product Analyzer</span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Analyze product ingredients and toxicity impact for environmental reporting</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">Analyze products →</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Carbon Calculation (Debug) Card -->
        <div class="col-md-6">
            <a href="/CarbonTest" class="text-decoration-none">
                <div class="card h-100" style="cursor:pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted fw-semibold" style="font-size:.82rem;letter-spacing:.5px;">Carbon Calculation (Debug)</span>
                        </div>
                        <div class="text-muted" style="font-size:.9rem;">Debug carbon calculation values and test emission computations</div>
                        <div class="mt-3" style="color:var(--cbc-brand);font-size:.85rem;">Test calculations →</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
