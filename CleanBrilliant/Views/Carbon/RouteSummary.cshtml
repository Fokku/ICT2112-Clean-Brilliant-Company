@{
    ViewData["Title"] = "Route Summary";
}

<div class="container py-4" id="route-summary-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Route Summary</h2>
        <a href="/Carbon" class="text-decoration-none" style="font-size:.9rem;">â† Back to Dashboard</a>
    </div>

    <div style="max-width:700px;margin:0 auto;">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Outbound Summary</h6>
                <form id="dashboard-outbound-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="dashboard-order-id" class="form-label" style="font-size:.85rem;">Order ID</label>
                            <input type="text" class="form-control" id="dashboard-order-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </form>
                <div id="dashboard-outbound-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.82rem;letter-spacing:.5px;">Inbound Summary</h6>
                <form id="dashboard-inbound-form">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="dashboard-restock-id" class="form-label" style="font-size:.85rem;">Restock ID</label>
                            <input type="text" class="form-control" id="dashboard-restock-id" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </form>
                <div id="dashboard-inbound-result" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carbon.js" asp-append-version="true"></script>
    <script>$(function () { Carbon.initRouteSummary(); });</script>
}
