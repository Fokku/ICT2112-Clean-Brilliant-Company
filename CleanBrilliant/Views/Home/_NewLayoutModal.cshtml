<div class="modal fade" id="newLayoutModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="Dashboard" asp-action="CreateLayout" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Create New Layout</h5></div>
            <div class="modal-body">
                <label>Layout Name</label>
                <input type="text" name="layoutName" class="form-control" required />
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-success">Create</button></div>
        </form>
    </div>
</div>