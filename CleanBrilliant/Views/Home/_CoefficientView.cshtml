<div style="border:1px solid #ddd; padding:10px; border-radius:8px; width:260px;">
    <strong>Coefficient:</strong>

    <div id="coefficientList">
        @foreach (var item in ViewBag.Coefficients)
        {
            <div style="display:flex; justify-content:space-between; margin-top:6px;">
                <span style="text-transform:capitalize;">@item.GetName()</span>

                <input type="number"
                       step="0.1"
                       value="@item.getEmission()"
                       data-name="@item.GetName()"
                       class="coef-input"
                       style="width:80px;" />
            </div>
        }
    </div>

    <div style="margin-top:10px; display:flex; gap:10px;">
        <button id="saveCoef" type="button">Save</button>
        <button id="cancelCoef" type="button">Cancel</button>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    let originalValues = {};

    const inputs = document.querySelectorAll(".coef-input");
    const saveBtn = document.getElementById("saveCoef");
    const cancelBtn = document.getElementById("cancelCoef");

    // Store initial values
    inputs.forEach(input => {
        originalValues[input.dataset.name] = input.value;
    });

    saveBtn.addEventListener("click", async function (event) {

        event.preventDefault();

        for (const input of inputs) {

            const name = input.dataset.name;
            const value = parseFloat(input.value);

            try {
                const response = await fetch('/Dashboard/UpdateCoefficient', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `name=${name}&emission=${value}`
                });

                // ❗ IMPORTANT: check if backend failed
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || "Invalid input");
                }

            } catch (err) {
                alert(err.message); // show actual error
                return; // STOP saving immediately
            }
        }

        // update snapshot only if ALL succeed
        inputs.forEach(input => {
            originalValues[input.dataset.name] = input.value;
        });

        alert("Saved!");
    });

    cancelBtn.addEventListener("click", function () {

        inputs.forEach(input => {
            const name = input.dataset.name;

            if (originalValues[name] !== undefined) {
                input.value = originalValues[name];
            }
        });

    });

});
</script>