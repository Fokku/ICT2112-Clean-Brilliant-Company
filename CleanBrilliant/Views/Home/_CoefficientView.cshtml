<div style="border:1px solid #ddd; padding:15px; border-radius:8px;">

    <!-- HEADER -->
    <h5 style="margin-bottom:10px;">Shipping Coefficient Simulator</h5>

    <!-- DESCRIPTION -->
    <div style="font-size:13px; color:#555; margin-bottom:15px;">
        The carbon footprint of a shipment is calculated using emission coefficients multiplied by the distance.<br>
        Adjust the coefficients below to simulate different emission scenarios.
    </div>

    <!-- COEFFICIENT LIST -->
    <div id="coefficientList">
        @foreach (var item in ViewBag.Coefficients)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
                
                <span style="text-transform:capitalize;">
                    @item.GetName()
                </span>

                <div style="display:flex; align-items:center; gap:6px;">
                    <input type="number"
                           step="0.1"
                           value="@item.getEmission()"
                           data-name="@item.GetName()"
                           class="coef-input"
                           style="width:80px;" />
                    <span style="font-size:12px; color:#666;">kg CO₂ / km</span>
                </div>
            </div>
        }
    </div>

    <!-- BUTTONS -->
    <div style="margin-top:12px; display:flex; gap:10px;">
        <button id="saveCoef" type="button">Save</button>
        <button id="cancelCoef" type="button">Cancel</button>
    </div>

    <hr style="margin:20px 0;" />

    <!-- SIMULATION SECTION --> <!-- Remove after integrated with P1-1 calculation properly. Else, keep as display -->
    <div>
        <strong style="font-size:14px;">Emission Calculator</strong>

        <div style="font-size:12px; color:#666; margin-top:5px; margin-bottom:10px;">
            Pick a transport method and enter distance to estimate emissions.
        </div>

        <!-- Transport -->
        <div style="margin-top:10px;">
            <label style="font-size:12px;">Transport Method</label><br>
            <select id="transportSelect">
                <option value="truck">Truck</option>
                <option value="ship">Ship</option>
                <option value="plane">Plane</option>
                <option value="train">Train</option>
            </select>
        </div>

        <!-- Distance -->
        <div style="margin-top:10px;">
            <label style="font-size:12px;">Distance (km)</label><br>
            <input type="number" id="distanceInput" value="10" min="0" />
        </div>

        <!-- Button -->
        <div style="margin-top:10px;">
            <button id="calculateBtn">Calculate</button>
        </div>

        <!-- Output -->
        <div style="margin-top:10px;">
            <strong>Output:</strong>
            <span id="resultOutput">-</span>
        </div>
    </div> 

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    let originalValues = {};

    const inputs = document.querySelectorAll(".coef-input");
    const saveBtn = document.getElementById("saveCoef");
    const cancelBtn = document.getElementById("cancelCoef");

    // Store initial values
    inputs.forEach(input => {
        originalValues[input.dataset.name] = input.value;
    });

    saveBtn.addEventListener("click", async function (event) {

        event.preventDefault();

        for (const input of inputs) {

            const name = input.dataset.name;
            const value = parseFloat(input.value);

            try {
                const response = await fetch('/Dashboard/UpdateCoefficient', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `name=${name}&emission=${value}`
                });

                // ❗ IMPORTANT: check if backend failed
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || "Invalid input");
                }

            } catch (err) {
                alert(err.message); // show actual error
                return; // STOP saving immediately
            }
        }

        // update snapshot only if ALL succeed
        inputs.forEach(input => {
            originalValues[input.dataset.name] = input.value;
        });

        alert("Saved!");
    });

    cancelBtn.addEventListener("click", function () {

        inputs.forEach(input => {
            const name = input.dataset.name;

            if (originalValues[name] !== undefined) {
                input.value = originalValues[name];
            }
        });

    });


document.getElementById("calculateBtn").addEventListener("click", async function () {

    const name = document.getElementById("transportSelect").value;
    const distance = parseFloat(document.getElementById("distanceInput").value);

    try {
        const response = await fetch(`/Dashboard/CalculateEmission?name=${name}&distance=${distance}`);

        if (!response.ok) {
            const error = await response.text();
            throw new Error(error);
        }

        const result = await response.json();

        document.getElementById("resultOutput").innerText = result + " kg CO₂";

    } catch (err) {
        alert(err.message);
    }
});

});
</script>